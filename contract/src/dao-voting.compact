pragma language_version >= 0.23;

import CompactStandardLibrary;

// Phase 0 verification contract.
//
// This deliberately proves the confirmed nullifier Set pattern first. Membership,
// private ballot branching, proposal Maps, weighted voting, and delegation are added
// only after their focused Compact spikes pass (docs/DESIGN.md section 14).

export sealed ledger owner: Bytes<32>;
export ledger spentNullifiers: Set<Bytes<32>>;
export ledger acceptedVotes: Counter;

witness administratorSecret(): Bytes<32>;
witness voterSecret(): Bytes<32>;

circuit ownerKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "dao-vote:owner:v1"), secret]
  );
}

circuit voteNullifier(secret: Bytes<32>, proposalId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "dao-vote:nullifier:v1"), secret, proposalId]
  );
}

constructor() {
  owner = disclose(ownerKey(administratorSecret()));
}

// Mechanical spike: prove proposal-scoped nullifiers can be checked and consumed.
// This is not the final castVote circuit because it does not yet prove membership or
// apply a private Yes / No / Abstain branch.
export circuit spikeConsumeNullifier(proposalId: Bytes<32>): Boolean {
  const nullifier = disclose(voteNullifier(voterSecret(), proposalId));
  assert(!spentNullifiers.member(nullifier), "nullifier spent");
  spentNullifiers.insert(nullifier);
  acceptedVotes.increment(1);
  return true;
}
